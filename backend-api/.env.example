DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/ewondo_learning"

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
CERTIFICATE_VERIFY_URL=http://localhost:3000/api/certificates/verify

PORT=3000

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=NdaMinkoaba

# --- Google sign-in (see README "OAuth sign-in setup") ---
# Comma-separated list of every OAuth Client ID you create (Web, Android, iOS) —
# verifyIdToken() accepts any of these as a valid audience. Leave empty to
# disable Google sign-in (POST /auth/google returns a clean 401 until set).
GOOGLE_CLIENT_ID=

# --- Production deployment ---
# Comma-separated list of allowed frontend origins (e.g. your deployed web
# app's URL). Leave unset to allow all origins, which is fine for local dev
# and short-lived tunnel-based testing but should be set for any long-lived
# public deployment.
CORS_ORIGINS=

# IMPORTANT: before deploying anywhere public, rotate both JWT_SECRET and
# OPENROUTER_API_KEY to fresh values — the ones used in local development
# have been exposed in this repo's history and must not be reused in
# production.
